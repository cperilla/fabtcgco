---
import Layout from '../layouts/Layout.astro';

const mechanics = [
  { name: "Arcane Barrier N", description: "Si fueras a recibir daño arcano, puedes pagar N recursos para prevenir N de ese daño.", color: "green" },
  { name: "Battleworn", description: "Si defiendes con esta carta, ponle un contador de -1 de Defensa cuando se cierre la cadena de combate.", color: "green" },
  { name: "Blade Break", description: "Si esta carta defendió, destrúyela cuando se cierre la cadena de combate.", color: "green" },
  { name: "Temper", description: "Cuando se cierre la cadena de combate, si esta carta defendió, ponle un contador de -1 de defensa y destrúyela si queda con 0 de defensa.", color: "green" },
  { name: "Cloaked", description: "Equipa esta carta boca abajo.", color: "yellow" },
  { name: "Spellvoid N", description: "Si fueras a recibir daño arcano, puedes destruir esta carta para prevenir N de ese daño.", color: "yellow" },
  { name: "Quell N", description: "Si fueras a recibir daño, puedes pagar N recursos para prevenir N de ese daño. Si lo haces, destruye esta carta al comienzo de la fase final.", color: "orange" },
  { name: "Guardwell", description: "Cuando se cierre la cadena de combate, si esta carta defendió, ponle una cantidad de contadores de -1 de defensa igual a su defensa.", color: "red" },
  { name: "Modular", description: "Esta carta puede equiparse en cualquiera de tus zonas de equipo y obtiene el subtipo de la zona donde esté equipada.", color: "red" },
  { name: "Pairs [with CARD]", description: "Solo puedes equipar esta carta si ya tienes equipada la carta indicada o si ambas se equipan como parte del mismo evento.", color: "red" },
  { name: "Arcane Shelter N", description: "Si fueras a recibir daño arcano, destruye esta carta para prevenir N de ese daño.", color: "red" },
  { name: "Perched", description: "Puede equiparse además de un arma de dos manos. Mientras esté equipada, esta carta no puede ser atacada.", color: "red" },
  { name: "[SUPERTYPE] Resist N", description: "Si fueras a recibir daño de un héroe con el supertipo indicado, puedes destruir esta carta para prevenir N de ese daño.", color: "red" },
];
---

<Layout>
<div class="mechanics-page">
    <div class="mechanics-header">
        <h1>Mecánicas de Equipos</h1>
        <div class="stars">
            <span style="color: #91160d;">★</span>
            <span style="color: #765d2f;">★</span>
            <span style="color: #91160d;">★</span>
            <span style="color: #765d2f;">★</span>
            <span style="color: #91160d;">★</span>
        </div>
        <p class="subtitle">Referencia rápida de mecánicas de equipos</p>
    </div>
    <div class="mechanics-container">
        {mechanics.map((mechanic) => (
            <article class={`mechanic-ticket mechanic-${mechanic.color}`}>
                <div class="mechanic-ticket-name">
                    <span class="name">{mechanic.name}</span>
                </div>
                <div class="mechanic-ticket-content">
                    <p class="description">{mechanic.description}</p>
                </div>
            </article>
        ))}
    </div>
</div>
</Layout>
