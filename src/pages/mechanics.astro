---
import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';

const mechanicSections = [
  {
    title: "Habilidades",
    description: "Palabras clave que definen habilidades de cartas.",
    mechanics: [
      { name: "Dominate", description: "Este ataque no puede ser defendido por más de 1 carta de la mano. Esto incluye las reacciones de defensa jugadas desde la mano.", color: "green" },
      { name: "Go again", description: "Al resolverse, otorga 1 punto de acción. Un objeto no puede tener más de una habilidad go again.", color: "green" },
      { name: "Overpower", description: "Este ataque no puede ser defendido por más de 1 carta de acción.", color: "green" },
      { name: "Ward N", description: "Si fueras a recibir daño, destruye esta carta para prevenir N de ese daño.", color: "green" },
      { name: "Blood Debt", description: "Mientras esta carta esté pública en tu zona de destierro, al comienzo de tu fase final pierdes 1 vida.", color: "green" },
      { name: "Boost", description: "Como costo adicional opcional para jugar esta carta, puedes desterrar la carta superior de tu mazo. Si es Mechanologist, esta carta obtiene go again.", color: "green" },
      { name: "Phantasm", description: "Cuando esta carta sea defendida por una carta de acción de ataque no Illusionist con 6 o más de poder, destruye esta carta.", color: "green" },
      { name: "Spectra", description: "Esta carta puede ser atacada. Cuando se convierta en objetivo de un ataque, destrúyela. Si no quedan otros objetivos legales, la cadena de combate se cierra.", color: "green" },
      { name: "Stealth", description: "Esta habilidad no tiene un efecto propio; otras habilidades y efectos pueden hacer referencia a ella.", color: "green" },
      { name: "[SUPERTYPES] Fusion", description: "Como costo adicional opcional para jugar esta carta, puedes revelar desde tu mano cartas con los supertipos indicados.", color: "green" },
      { name: "Crank", description: "Mientras esta carta entra en la arena, puedes removerle 1 steam counter. Si lo haces, ganas 1 punto de acción.", color: "green" },
      { name: "Piercing N", description: "Si esta carta es defendida por un equipo, obtiene +N de poder.", color: "green" },
      { name: "Scrap", description: "Como costo adicional opcional para jugar esta carta, puedes desterrar un Item o Equipment de tu cementerio.", color: "green" },
      { name: "Beat Chest", description: "Como costo adicional opcional para jugar esta carta, puedes descartar una carta con 6 o más de poder.", color: "green" },
      { name: "Ephemeral", description: "No puedes comenzar la partida con esta carta en tu mazo. Si fuera a ir a un cementerio desde cualquier lugar, en vez de eso remuévela del juego.", color: "green" },
      { name: "Essence of [SUPERTYPES]", description: "Puedes incluir cartas con los supertipos indicados en tu mazo como si tu héroe tuviera esos supertipos.", color: "green" },
      { name: "Heave N", description: "Mientras esté en tu mano, al comienzo de tu fase final puedes pagar N recursos y poner esta carta boca arriba en un arsenal vacío. Si lo haces, crea N Seismic Surge tokens.", color: "green" },
      { name: "Ambush", description: "Mientras esta carta esté en tu arsenal, puedes defender con ella.", color: "green" },
      { name: "Protect", description: "Puedes defender con esta carta a cualquier héroe atacado por un oponente.", color: "green" },
      { name: "Universal", description: "Mientras esté en cualquier zona, esta carta es de la misma clase que tu héroe.", color: "green" },
      { name: "Mirage", description: "Cuando esta carta defienda un ataque no Illusionist con 6 o más de poder, destrúyela.", color: "red" },
      { name: "Rune Gate", description: "Si controlas una cantidad de Runechants igual o mayor al costo de esta carta, puedes jugarla desde tu zona de destierro sin pagar su costo de recursos.", color: "red" },
      { name: "Meld", description: "Puedes pagar el doble del costo base de esta carta dividida para jugar ambas mitades. La carta conserva las propiedades combinadas de ambos lados mientras permanezca melded.", color: "red" },
      { name: "Unlimited", description: "Puedes incluir cualquier cantidad de copias de esta carta en tu mazo.", color: "red" },
      { name: "Watery Grave", description: "Cuando esta carta vaya de la arena a tu cementerio, voltéala boca abajo.", color: "red" },
      { name: "Suspense", description: "Entra en la arena con 2 suspense counters. Al inicio de tu turno, remueve 1; cuando no tenga ninguno, destrúyela.", color: "red" },
      { name: "Fragment", description: "Cuando una carta con 2 o más de defensa defienda este ataque, este obtiene -2 de poder.", color: "red" },
      { name: "Binds [to CARD]", description: "Al entrar en la arena, vincula esta carta a una carta válida del tipo indicado. Si queda desvinculada, se limpia como acción de estado de juego.", color: "red" },
      { name: "Decay", description: "Al comienzo de tu fase final, pon un contador de -1 de vida sobre esta carta.", color: "red" },
      { name: "Incarnate", description: "No puedes comenzar la partida con esta carta en tu mazo. Si fuera a morir, en vez de eso remuévela del juego; no se considera que murió.", color: "red" },
      { name: "Unique", description: "Solo puedes controlar 1 permanente con este nombre o moniker.", color: "red" },
      { name: "Usurp", description: "Como costo adicional para jugar esta carta, destruye un Runechant si puedes. Si destruyes uno de esta manera, esta carta obtiene +2 de poder.", color: "red" },
    ],
  },
  {
    title: "Etiquetas de habilidad",
    description: "Condiciones identificadas por una etiqueta cuyo efecto completo aparece en la carta.",
    mechanics: [
      { name: "Combo", description: "Si una de las cartas indicadas fue el último ataque de esta cadena de combate, aplica el efecto impreso después de Combo.", color: "yellow" },
      { name: "Contract", description: "Te asigna una condición y una recompensa. Puedes completar el contrato cualquier cantidad de veces mientras exista su efecto.", color: "yellow" },
      { name: "Crush", description: "Cuando este ataque cause 4 o más de daño, aplica el efecto impreso después de Crush.", color: "yellow" },
      { name: "Reprise", description: "Si el héroe defensor defendió con una carta de su mano en este eslabón de cadena, aplica el efecto impreso después de Reprise. La condición se comprueba al resolver.", color: "yellow" },
      { name: "Channel [SUPERTYPE]", description: "Al comienzo de tu fase final, pon un flow counter sobre esta carta y luego destrúyela, a menos que pongas en el fondo de tu mazo una carta del supertipo indicado desde tu zona de pitch por cada flow counter.", color: "yellow" },
      { name: "Evo Upgrade", description: "El efecto impreso escala por cada Evo que tengas equipada, o usa como X la cantidad de Evos que tengas equipadas.", color: "yellow" },
      { name: "Galvanize", description: "Cuando esta carta defienda, puedes destruir un Item que controles. Si lo haces, aplica el efecto impreso después de Galvanize.", color: "yellow" },
      { name: "Tower", description: "Si esta carta tiene 13 o más de poder, aplica el efecto impreso después de Tower.", color: "yellow" },
      { name: "Material", description: "Mientras esta carta esté debajo de un permanente, aplica el efecto impreso después de Material.", color: "red" },
      { name: "Rupture", description: "Si esta carta se juega como o en el eslabón 4 o superior de la cadena, aplica el efecto impreso después de Rupture.", color: "red" },
      { name: "Surge", description: "Si esta carta causa la cantidad indicada de daño, aplica el efecto impreso después de Surge.", color: "red" },
      { name: "Solflare", description: "Cuando esta carta sea cargada al alma de tu héroe, aplica el efecto impreso después de Solflare.", color: "red" },
      { name: "Unity", description: "Cuando esta carta defienda junto con una carta de la mano, aplica el efecto impreso después de Unity.", color: "red" },
      { name: "Decompose", description: "Puedes desterrar de tu cementerio 2 cartas Earth y 1 carta de acción. Si lo haces, aplica el efecto impreso después de Decompose.", color: "red" },
      { name: "[ELEMENT] Bond", description: "Si se usó una carta del elemento indicado como pitch para jugar esta carta, aplica el efecto impreso después de Bond.", color: "red" },
      { name: "[ELEMENT] Flow", description: "Si jugaste una carta del elemento indicado este turno, aplica el efecto impreso después de Flow.", color: "red" },
      { name: "Heavy", description: "Si esta es la única carta equipada en tus zonas de armas, aplica el efecto impreso después de Heavy.", color: "red" },
      { name: "High Tide", description: "Si hay 2 o más cartas azules en tu zona de pitch, aplica el efecto impreso después de High Tide.", color: "red" },
      { name: "Go Fish", description: "Cuando este ataque impacte a un héroe, ese jugador elige y revela una carta de su mano. Si cumple la cualidad indicada, la descarta y tú creas un Gold token.", color: "red" },
      { name: "Quickstrike", description: "Si esta carta tiene go again, aplica el efecto impreso después de Quickstrike.", color: "red" },
      { name: "Starfall", description: "Si una carta de instant fue puesta en tu cementerio este turno, aplica el efecto impreso después de Starfall.", color: "red" },
    ],
  },
  {
    title: "Efectos",
    description: "Acciones de juego definidas por las reglas.",
    mechanics: [
      { name: "Opt N", description: "Mira las N cartas superiores de tu mazo. Pon cualquier cantidad arriba o abajo del mazo, en cualquier orden.", color: "orange" },
      { name: "Clash", description: "Los jugadores enfrentados revelan la carta superior de sus mazos. Gana quien revele la carta con mayor poder. Una carta sin propiedad de poder pierde frente a cualquier carta que sí la tenga; si no hay un valor mayor que todos los demás, nadie gana.", color: "orange" },
      { name: "Intimidate", description: "El jugador destierra boca abajo una carta al azar de su mano. Al comienzo de la fase final, esa carta regresa a su mano.", color: "orange" },
      { name: "Reload", description: "Si todos tus arsenales están vacíos, puedes poner una carta de tu mano boca abajo en tu arsenal.", color: "orange" },
      { name: "Charge", description: "Mueve una carta de tu mano al alma de tu héroe. Moverla al alma por otro efecto no cuenta como haberla cargado.", color: "orange" },
      { name: "Wager", description: "Al resolverse el eslabón, el controlador del ataque gana el premio si el ataque impactó; de lo contrario lo gana el otro jugador. Si el premio es un token, quien gane lo crea bajo su control.", color: "orange" },
      { name: "Amp N", description: "La próxima vez que un evento que controles fuera a causar daño arcano este turno, causa esa cantidad más N.", color: "orange" },
      { name: "Transcend", description: "Pon la carta que genera este efecto en la mano de su dueño con su cara posterior activa. Esa cara permanece activa durante el resto de la partida.", color: "orange" },
      { name: "Exchange", description: "Los objetos intercambian simultáneamente sus zonas, visibilidad y control. Si alguno no puede completar el movimiento, el efecto falla.", color: "red" },
      { name: "Mark", description: "El héroe obtiene la condición marked hasta que sea impactado por una fuente controlada por un oponente o deje de existir.", color: "red" },
      { name: "Retrieve", description: "Puedes pagar 1 recurso para equipar la carta. No puedes pagar si la carta no existe o no puede ser equipada.", color: "red" },
      { name: "Return to the Brood", description: "Dejan de existir los efectos de transformación o copia que se estén aplicando a tu héroe.", color: "red" },
      { name: "Give", description: "El jugador indicado obtiene el control del objeto. Si está equipado, debe poder equiparlo como parte del cambio de control.", color: "red" },
      { name: "Steal", description: "Obtienes el control de la carta. Si está equipada, debes poder equiparla como parte del cambio de control.", color: "red" },
      { name: "Tap", description: "Cambia un permanente de su estado untapped a tapped. El efecto falla si ya está tapped.", color: "red" },
      { name: "Untap", description: "Cambia un permanente de su estado tapped a untapped. El efecto falla si ya está untapped.", color: "red" },
      { name: "The Crowd Cheers / Boos", description: "El jugador es considerado cheered o booed. Si ocurren ambos, conserva las dos condiciones; no se anulan entre sí.", color: "red" },
      { name: "Sharpen", description: "Pon un contador de +1 de poder sobre la carta. Al comienzo de la fase final, remueve de ella todos los contadores de +1 de poder.", color: "red" },
      { name: "Cut", description: "Mueve entre 1 y X cartas de la parte superior del mazo al fondo, conservando su orden, donde X es la cantidad de cartas del mazo menos 1.", color: "red" },
      { name: "Traverse", description: "La cara no activa de una carta de doble cara pasa a ser su cara activa.", color: "red" },
    ],
  },
];

const categoryDefinitions = [
  {
    title: "Ataque y evasión",
    icon: "fa-solid fa-burst",
    description: "Restricciones de defensa, modificación del ataque y resultados del combate.",
    names: ["Dominate", "Overpower", "Piercing N", "Phantasm", "Mirage", "Spectra", "Wager"],
  },
  {
    title: "Bloqueo y prevención",
    icon: "fa-solid fa-shield-halved",
    description: "Formas especiales de defender, prevenir daño o mejorar una defensa.",
    names: ["Ward N", "Ambush", "Protect", "Galvanize", "Unity"],
  },
  {
    title: "Modificación de costos",
    icon: "fa-solid fa-coins",
    description: "Costos adicionales, opcionales o alternativos para jugar una carta y obtener sus beneficios.",
    names: ["Boost", "[SUPERTYPES] Fusion", "Scrap", "Beat Chest", "Rune Gate", "Meld", "Usurp", "Decompose"],
  },
  {
    title: "Economía de acciones y preparación",
    icon: "fa-solid fa-bolt",
    description: "Puntos de acción y efectos que preparan cartas para continuar este turno o uno posterior.",
    names: ["Go again", "Crank", "Heave N", "Reload"],
  },
  {
    title: "Recursos, pitch y alma",
    icon: "fa-solid fa-gem",
    description: "Mecánicas que verifican el pitch o mueven cartas al alma del héroe.",
    names: ["[ELEMENT] Bond", "Charge"],
  },
  {
    title: "Modificación de daño y poder",
    icon: "fa-solid fa-chart-line",
    description: "Efectos que aumentan o reducen el daño o el poder de una fuente.",
    names: ["Fragment", "Amp N", "Sharpen"],
  },
  {
    title: "Efectos condicionales",
    icon: "fa-solid fa-code-branch",
    description: "Efectos que se aplican cuando una condición indicada ya es verdadera.",
    names: ["Combo", "Reprise", "Evo Upgrade", "Tower", "Material", "Rupture", "Surge", "[ELEMENT] Flow", "Heavy", "High Tide", "Quickstrike", "Starfall"],
  },
  {
    title: "Efectos disparados",
    icon: "fa-solid fa-clock-rotate-left",
    description: "Habilidades que se disparan cuando ocurre un evento o se cumple un estado del juego.",
    names: ["Blood Debt", "Contract", "Crush", "Channel [SUPERTYPE]", "Solflare", "Go Fish", "Suspense", "Decay"],
  },
  {
    title: "Construcción e identidad",
    icon: "fa-solid fa-layer-group",
    description: "Reglas que cambian cómo una carta entra al mazo, qué clase tiene o cuántas copias admite.",
    names: ["Ephemeral", "Essence of [SUPERTYPES]", "Universal", "Unlimited", "Incarnate", "Unique"],
  },
  {
    title: "Condiciones y estados",
    icon: "fa-solid fa-toggle-on",
    description: "Etiquetas, vínculos y estados persistentes que afectan héroes o permanentes.",
    names: ["Stealth", "Binds [to CARD]", "Mark", "Tap", "Untap", "The Crowd Cheers / Boos"],
  },
  {
    title: "Transformación y caras",
    icon: "fa-solid fa-arrows-rotate",
    description: "Cambios de cara, transformación y retorno de una carta o héroe a su estado base.",
    names: ["Watery Grave", "Transcend", "Return to the Brood", "Traverse"],
  },
  {
    title: "Información, azar y mazo",
    icon: "fa-solid fa-shuffle",
    description: "Consultar, comparar o reorganizar cartas del mazo y ocultar información de la mano.",
    names: ["Opt N", "Clash", "Intimidate", "Cut"],
  },
  {
    title: "Control, equipo y zonas",
    icon: "fa-solid fa-arrow-right-arrow-left",
    description: "Intercambiar control, equipar o mover objetos entre jugadores y zonas.",
    names: ["Exchange", "Give", "Steal", "Retrieve"],
  },
];

const mechanicsByName = new Map(
  mechanicSections.flatMap((section) => section.mechanics.map((mechanic) => [
    mechanic.name,
    { ...mechanic, rulesKind: section.title },
  ]))
);

const categorizedSections = categoryDefinitions.map((category) => ({
  ...category,
  mechanics: category.names
    .map((name) => mechanicsByName.get(name))
    .filter(Boolean)
    .sort((a, b) => a.name.localeCompare(b.name, "es", { sensitivity: "base" })),
}));

const categorizedNames = new Set(categoryDefinitions.flatMap(({ names }) => names));
const uncategorized = [...mechanicsByName.keys()].filter((name) => !categorizedNames.has(name));
if (uncategorized.length > 0) {
  throw new Error(`Mecánicas sin categoría: ${uncategorized.join(", ")}`);
}

const triggeredMechanics = new Set([
  "Blood Debt", "Phantasm", "Spectra", "Mirage", "Fragment", "Suspense", "Decay",
  "Contract", "Crush", "Channel [SUPERTYPE]", "Solflare", "Unity", "Galvanize", "Go Fish",
]);

const conditionalMechanics = new Set([
  "Combo", "Reprise", "Evo Upgrade", "Tower", "Material", "Rupture", "Surge",
  "Decompose", "[ELEMENT] Bond", "[ELEMENT] Flow", "Heavy", "High Tide", "Quickstrike", "Starfall",
]);

const mechanicId = (name) => `mecanica-${name
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "")}`;

const sectionId = (title) => `seccion-${title
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")}`;

---

<Layout>
<div class="mechanics-page">
    <div class="mechanics-header">
        <h1>Mecánicas de Juego</h1>
        <div class="stars">
            <span style="color: #91160d;">★</span>
            <span style="color: #765d2f;">★</span>
            <span style="color: #91160d;">★</span>
            <span style="color: #765d2f;">★</span>
            <span style="color: #91160d;">★</span>
        </div>
        <p class="subtitle">Referencia organizada por función y comportamiento</p>
    </div>
    <PageBanner image="/images/home/mechanics-guides.webp" alt="Mesa de estudio con cartas y diagramas de mecánicas" />
    <nav class="mechanics-index" id="indice-mecanicas" aria-labelledby="index-title">
        <div class="index-heading">
            <p class="section-kicker">Índice funcional</p>
            <h2 id="index-title">Mapa de mecánicas</h2>
            <p>Cada mecánica aparece en la categoría que mejor describe su función principal.</p>
        </div>
        <div class="category-nav">
            {categorizedSections.map((section) => (
                <a href={`#${sectionId(section.title)}`}>
                    <i class={section.icon} aria-hidden="true"></i>
                    <span>
                        <strong>{section.title}</strong>
                        <small>{section.mechanics.length} mecánicas</small>
                    </span>
                </a>
            ))}
        </div>
    </nav>

    <aside class="taxonomy-legend" aria-label="Tipos de mecánica">
        <span><b class="legend-dot legend-dot--ability"></b><strong>Habilidad:</strong> regla propia de la carta.</span>
        <span><b class="legend-dot legend-dot--label"></b><strong>Etiqueta:</strong> agrupa un efecto escrito en la carta.</span>
        <span><b class="legend-dot legend-dot--effect"></b><strong>Efecto:</strong> instrucción definida por las reglas.</span>
    </aside>

    {categorizedSections.map((section, sectionIndex) => (
        <section class="mechanics-section" id={sectionId(section.title)}>
            <div class="mechanics-section-header">
                <div class="section-title">
                    <span class="section-icon"><i class={section.icon} aria-hidden="true"></i></span>
                    <div>
                        <p class="section-kicker">Categoría {String(sectionIndex + 1).padStart(2, "0")}</p>
                        <h2>{section.title}</h2>
                    </div>
                </div>
                <p>{section.description}</p>
            </div>
            <div class="mechanics-container">
                {section.mechanics.map((mechanic) => (
                    <article class={`mechanic-ticket kind-${mechanic.rulesKind === "Habilidades" ? "ability" : mechanic.rulesKind === "Etiquetas de habilidad" ? "label" : "effect"}`} id={mechanicId(mechanic.name)}>
                        <div class="mechanic-ticket-name">
                            <h3 class="name">{mechanic.name}</h3>
                        </div>
                        <div class="mechanic-ticket-content">
                            <p class="description">{mechanic.description}</p>
                            <div class="mechanic-tags">
                                <span>{mechanic.rulesKind === "Etiquetas de habilidad" ? "Etiqueta" : mechanic.rulesKind.slice(0, -1)}</span>
                                {triggeredMechanics.has(mechanic.name) && <span>Disparada</span>}
                                {conditionalMechanics.has(mechanic.name) && <span>Condicional</span>}
                            </div>
                        </div>
                    </article>
                ))}
            </div>
            <a class="back-to-index" href="#indice-mecanicas">↑ Volver al índice</a>
        </section>
    ))}
</div>
</Layout>

<style>
    :global(html) {
        scroll-behavior: smooth;
    }

    .mechanics-index {
        max-width: 900px;
        margin: 0 auto 1.5rem;
    }

    .mechanics-index {
        padding: clamp(1.25rem, 4vw, 2rem);
        border: 1px solid var(--border-color);
        border-radius: 1rem;
        background: var(--bg-dark-2);
    }

    .index-heading {
        margin-bottom: 1.25rem;
    }

    .index-heading h2 {
        margin: 0.1rem 0 0.35rem;
        color: var(--neutral-color);
        font-size: clamp(1.35rem, 4vw, 1.75rem);
    }

    .index-heading p {
        margin: 0;
    }

    .index-heading p:not(.section-kicker) {
        color: var(--muted-color);
    }

    .section-kicker {
        margin: 0;
        color: #d7b26a;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .category-nav {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.5rem;
    }

    .category-nav > a {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.15rem 0.65rem;
        align-items: center;
        min-height: 4.25rem;
        padding: 0.7rem 0.8rem;
        border: 1px solid var(--border-color);
        border-radius: 0.5rem;
        background: var(--bg-dark-1);
        color: var(--text-color);
        text-decoration: none;
    }

    .category-nav > a:hover {
        border-color: #a68850;
        background: rgba(118, 93, 47, 0.16);
    }

    .category-nav i {
        grid-row: span 2;
        width: 1.25rem;
        color: #d7b26a;
        text-align: center;
    }

    .category-nav strong,
    .category-nav small {
        display: block;
    }

    .category-nav small {
        color: var(--muted-color);
    }

    .taxonomy-legend {
        max-width: 900px;
        margin: 0 auto 2.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.25rem;
        padding: 0.9rem 1rem;
        border: 1px solid var(--border-color);
        border-radius: 0.75rem;
        color: var(--muted-color);
        font-size: 0.78rem;
    }

    .taxonomy-legend span {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    .taxonomy-legend strong {
        color: var(--text-color);
    }

    .legend-dot {
        width: 0.55rem;
        height: 0.55rem;
