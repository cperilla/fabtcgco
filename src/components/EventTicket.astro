---
import { format, parseISO } from 'date-fns';
import { es } from 'date-fns/locale';
import type { Event } from './interfaces';
import { generateICS, getGoogleCalendarLink } from './interfaces';
import shinsei from '../data/shinsei.json';

interface Props {
  event: Event;
  index: number;
}

const { event, index } = Astro.props;
const isShinsei = event.location.spot === shinsei.name;

const eventDate = parseISO(event.date);
const dayNumber = format(eventDate, 'd');
const monthAbbr = format(eventDate, 'MMM', { locale: es }).toUpperCase();

const icsContent = generateICS(event);
const icsDataUrl = `data:text/calendar;charset=utf-8,${encodeURIComponent(icsContent)}`;
const googleCalUrl = getGoogleCalendarLink(event);

const isEven = index % 2 === 0;
const layoutClass = isEven ? 'event-ticket--left' : 'event-ticket--right';
const typeClass = `event-type-${(event.type || 'default').toLowerCase()}`;
const eventKey = `${event.date}-${event.title}-${event.time}-${event.location.spot}`;

// Extract card name from tournament name (strip date portion)
// Format: "FAB Chaos Sage Jue 12/02/26 : Brothers in Arms" -> "Brothers in Arms"
const getCardName = (tournamentName?: string) => {
  if (!tournamentName) return null;
  const colonIndex = tournamentName.indexOf(':');
  if (colonIndex === -1) return null;
  return tournamentName.slice(colonIndex + 1).trim();
};

const cardName = getCardName(event.tournamentName);
const hasTournament = !!event.tournamentUrl;

// Map event types to format page URLs
const formatUrls: Record<string, string> = {
  'Sage': '/formato/sage',
  'CC': '/formato/cc',
  'LL': '/formato/living-legend'
};
const formatUrl = event.type ? formatUrls[event.type] : null;
---

<article
  class={`event-ticket ${layoutClass} ${typeClass} ${hasTournament ? 'event-ticket--has-tournament' : ''} ${isShinsei ? 'event-ticket--shinsei' : ''}`}
  data-event-date={event.date}
  data-event-key={eventKey}
>
  <div class="event-ticket-date">
    <span class="day">{dayNumber}</span>
    <span class="month">{monthAbbr}</span>
  </div>
  <div class="event-ticket-content">
    {isShinsei && <div class="shinsei-host"><img src={shinsei.logo} width="48" height="50" alt="Shinsei Store" /><span>Tienda anfitriona · {shinsei.name}</span></div>}
    {cardName ? (
      <h3 class="tournament-title">
        <span class="card-name-part">{cardName}</span>
        <span class="separator">:</span>
        {formatUrl ? (
          <a href={formatUrl} class="format-part format-link">{event.icon} {event.title} Tournament</a>
        ) : (
          <span class="format-part">{event.icon} {event.title} Tournament</span>
        )}
      </h3>
    ) : (
      <div class="event-ticket-header">
        {formatUrl ? (
          <h3 class="title"><a href={formatUrl} class="format-link">{event.icon} {event.title}</a></h3>
        ) : (
          <h3 class="title">{event.icon} {event.title}</h3>
        )}
        <span class="location-badge">{event.location.spot}</span>
      </div>
    )}
    <div class="event-meta">
      <span class="time">{event.time}</span>
      <span class="location-full">{event.location.city}, {event.location.spot}{event.location.address && ` · ${event.location.address}`}</span>
    </div>
    {(event.registrationFee || event.description) && (
      <div class="event-details">
        {event.registrationFee && <span class="registration-fee">Inscripción: {event.registrationFee}</span>}
        {event.description && <p>{event.description}</p>}
      </div>
    )}
    <div class="actions">
      {isShinsei && <a href={shinsei.preparationUrl} class="action-link">Prepararme en Mesa Inicial →</a>}
      {hasTournament && (
        <a href={event.tournamentUrl} target="_blank" rel="noopener noreferrer" class="action-link action-link--tournament action-link--primary">
          🏆 Inscribirse
        </a>
      )}
      <a href={icsDataUrl} download={`${event.title.replace(/\s/g, '_')}.ics`} class="action-link">
        📥 iCal
      </a>
      <a href={googleCalUrl} target="_blank" rel="noopener noreferrer" class="action-link">
        📅 Google
      </a>
    </div>
  </div>
</article>

<style>
  .shinsei-host { display: flex; align-items: center; gap: .65rem; margin-bottom: .75rem; color: #edd2ed; font-weight: 600; font-size: .85rem; }
  .shinsei-host img { width: 48px; height: auto; }
  .event-ticket--shinsei { border-color: #b89bc9; }
</style>
